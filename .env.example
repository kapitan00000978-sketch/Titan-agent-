# ==========================================
# TITAN AGENT SETTINGS
# ==========================================

# 1. LLM Provider: puter (browser-side, no key), openrouter, deepseek, groq, ollama, lmstudio, openai
TITAN_PROVIDER=puter
TITAN_MODEL=deepseek/deepseek-v4-pro

# 2. API Keys (NOT required for Puter.js; required for other providers):
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 3. Local Ollama settings (if you use a local model):
OLLAMA_BASE_URL=http://localhost:11434

# 4. Agent settings:
TITAN_PORT=7860
TITAN_AUTONOMOUS=true
TITAN_MAX_ITERATIONS=25
TITAN_MODE=fast            # fast | deep | deep_search
TITAN_EFFORT=auto          # auto | low | medium | high | ultra (auto derives from mode)