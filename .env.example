# ==========================================
# TITAN AGENT SETTINGS
# ==========================================

# 1. LLM Provider: omni (default), puter (browser-side, no key), openrouter, deepseek, groq, ollama, lmstudio, openai
# OmniRoute — self-hosted AI gateway (localhost:20128) with smart auto-routing.
TITAN_PROVIDER=omni
TITAN_MODEL=auto

# Puter.js — developer.puter.com models (no key, runs directly in the browser)
# TITAN_PROVIDER=puter
# TITAN_MODEL=deepseek/deepseek-v4-pro

# 2. API Keys (NOT required for Puter.js / OmniRoute; required for other providers):
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 3. OmniRoute — self-hosted AI gateway (dashboard at http://localhost:20128)
# Auto-routing models: auto, auto/coding, auto/fast, auto/smart, auto/offline, auto/cheap
# The dashboard key is copied to .env (never commit real values).
OMNI_API_KEY=
OMNI_BASE_URL=http://localhost:20128/v1

# 4. Local Ollama settings (if you use a local model):
OLLAMA_BASE_URL=http://localhost:11434

# 5. Agent settings:
TITAN_PORT=7860
TITAN_AUTONOMOUS=true
TITAN_MAX_ITERATIONS=25
TITAN_MODE=fast            # fast | deep | deep_search
TITAN_EFFORT=auto          # auto | low | medium | high | ultra (auto derives from mode)
TITAN_TOKEN_RATE_LIMIT=214000  # token throughput guardrail (tokens/sec, never exceeded)

# 6. Completions.me — free OpenAI-compatible gateway (Claude Opus / GPT-5 / Gemini / Grok)
COMPLETIONS_API_KEY=
COMPLETIONS_BASE_URL=https://completions.me/api/v1

# 7. Telegram account manager (opt-in, consent-gated)
# MUST be true for any Telegram tool to work. Get api_id/api_hash at
# https://my.telegram.org -> API development tools. Never commit real values.
TITAN_TELEGRAM_ENABLED=false
TITAN_TELEGRAM_API_ID=
TITAN_TELEGRAM_API_HASH=
# Comma-separated targets the agent may message (empty = read-only, no sending)
TITAN_TELEGRAM_SEND_ALLOWLIST=