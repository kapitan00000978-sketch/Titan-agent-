# ==========================================
# TITAN AGENT SETTINGS
# ==========================================

# 1. LLM Provider: omni (default), puter (browser-side, no key), openrouter, deepseek, groq, ollama, lmstudio, openai
# OmniRoute — self-hosted AI gateway (localhost:20128) with smart auto-routing.
TITAN_PROVIDER=omni
TITAN_MODEL=auto

# Puter.js — developer.puter.com models (no key, runs directly in the browser)
# TITAN_PROVIDER=puter
# TITAN_MODEL=deepseek/deepseek-v4-pro

# 2. API Keys (NOT required for Puter.js / OmniRoute; required for other providers):
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 3. OmniRoute — self-hosted AI gateway (dashboard at http://localhost:20128)
# Auto-routing models: auto, auto/coding, auto/fast, auto/smart, auto/offline, auto/cheap
# The dashboard key is copied to .env (never commit real values).
OMNI_API_KEY=
OMNI_BASE_URL=http://localhost:20128/v1

# 4. Local Ollama settings (if you use a local model):
OLLAMA_BASE_URL=http://localhost:11434

# 5. Agent settings:
TITAN_PORT=7860
TITAN_AUTONOMOUS=true
TITAN_MAX_ITERATIONS=25
TITAN_MODE=fast            # fast | deep | deep_search
TITAN_EFFORT=auto          # auto | low | medium | high | ultra (auto derives from mode)
TITAN_TOKEN_RATE_LIMIT=214000  # token throughput guardrail (tokens/sec, never exceeded)

# 5b. Phase 7 — Full Autonomy (unlimited step budget, task queue, daemon):
# TITAN_STEP_CAP: ceiling applied after effort scaling (default 48 — was hardcoded).
TITAN_STEP_CAP=48
# TITAN_UNLIMITED_STEPS=1 removes the step ceiling entirely — the agent keeps
# iterating until the task is provably done (it still must verify + answer).
TITAN_UNLIMITED_STEPS=0
TITAN_DEEP_MAX_STEPS=40        # deep modes' extra budget base (was hardcoded at 40)
TITAN_TASK_QUEUE=              # SQLite path for the autonomous task queue (default: workspace/task_queue.db)
TITAN_DAEMON_INTERVAL=5.0      # daemon poll interval (seconds)
TITAN_DAEMON_CONCURRENCY=1     # parallel task workers (max concurrent)

# 5c. Phase 8 — FULL ACCESS: remove EVERY capability boundary.
# TITAN_FULL_ACCESS=1 enables:
#   - No step budget cap (budget scaled 4x, no ceiling until task is done)
#   - Command timeout raised from 45s to 10 minutes
#   - Approval gates auto-granted (delete_file / screenshot / ports / paths)
#   - download_file: no 100 MB cap, fetch timeout 30s -> 2 minutes
#   - start_http_server: any valid port (1-65535)
#   - Token rate-limiter disabled
#   - Subagent teams: up to 8 parallel workers
#   Full Access KEEPS the protection floor: destructive-command denies
#   (rm -rf / format / mkfs / shutdown) and the SSRF private-network guard.
# TITAN_ABSOLUTE_ACCESS=1 additionally lifts THOSE two lines too — the last
# protection floor. It implies FULL_ACCESS. Use only when you accept that the
# agent can reach destructive operations and internal networks it asks for.
TITAN_FULL_ACCESS=0
TITAN_ABSOLUTE_ACCESS=0

# 6. Completions.me — free OpenAI-compatible gateway (Claude Opus / GPT-5 / Gemini / Grok)
COMPLETIONS_API_KEY=
COMPLETIONS_BASE_URL=https://completions.me/api/v1

# 7. Telegram account manager (opt-in, consent-gated)
# MUST be true for any Telegram tool to work. Get api_id/api_hash at
# https://my.telegram.org -> API development tools. Never commit real values.
TITAN_TELEGRAM_ENABLED=false
TITAN_TELEGRAM_API_ID=
TITAN_TELEGRAM_API_HASH=
# Comma-separated targets the agent may message (empty = read-only, no sending)
TITAN_TELEGRAM_SEND_ALLOWLIST=