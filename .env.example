# ==========================================
# TITAN AGENT SOZLAMALARI
# ==========================================

# 1. LLM Provayder: puter (bepul, kalitsiz), openrouter, deepseek, groq, ollama, lmstudio, openai
TITAN_PROVIDER=puter
TITAN_MODEL=deepseek/deepseek-v4-pro

# 2. API Kalitlari (Puter.js uchun shart EMAS; boshqa provayderlar uchun kiriting):
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 3. Mahalliy Ollama sozlamasi (agar mahalliy model ishlatsangiz):
OLLAMA_BASE_URL=http://localhost:11434

# 4. Agent sozlamalari:
TITAN_PORT=7860
TITAN_AUTONOMOUS=true
TITAN_MAX_ITERATIONS=25