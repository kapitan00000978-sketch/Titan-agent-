# ==========================================
# TITAN AGENT SETTINGS
# ==========================================

# 0. Server authentication (Phase 12): Bearer token required on every /api route.
# If left empty, a random key is generated on first run, printed once to the
# console and persisted to workspace/.server_key (gitignored) so restarts reuse
# it. Set it here to control it explicitly.
TITAN_API_KEY=

# 1. LLM Provider: extra-llm-x (640+ free models), g4f (free), puter (browser), ollama (local), groq, gemini, openrouter
EXTRA_LLM_X_PROVIDER=extra-llm-x
EXTRA_LLM_X_MODEL=extra/auto-free
TITAN_PROVIDER=extra-llm-x
TITAN_MODEL=extra/auto-free

# Puter.js — developer.puter.com models (no key, runs directly in the browser)
# TITAN_PROVIDER=puter
# TITAN_MODEL=deepseek/deepseek-v4-pro

# 2. API Keys:
# Free Tier Providers (Get key for free without credit card):
EXTRA_LLM_X_API_KEY=   # Unified Gateway (localhost:3000): extra-llm-x-free-key
EXTRA_LLM_X_BASE_URL=  # http://localhost:3000/v1
OPENROUTER_API_KEY=    # Free keys & models: https://openrouter.ai/keys
GROQ_API_KEY=          # Ultra-fast free LPU key: https://console.groq.com/keys
GEMINI_API_KEY=        # Free 15 RPM / 1,500 RPD key: https://aistudio.google.com/app/apikey
SAMBANOVA_API_KEY=     # Free fast 70B inference: https://cloud.sambanova.ai/apis
TOGETHER_API_KEY=      # Free tier fast inference: https://api.together.xyz/
CEREBRAS_API_KEY=      # World's fastest Llama inference: https://cloud.cerebras.ai/
COHERE_API_KEY=        # Command-R free evaluation tier: https://dashboard.cohere.com/api-keys
GITHUB_TOKEN=          # Free with GitHub Personal Token: https://github.com/settings/tokens
MISTRAL_API_KEY=       # Codestral free tier: https://console.mistral.ai/api-keys/
HUGGINGFACE_API_KEY=   # Free inference token: https://huggingface.co/settings/tokens

# Commercial providers:
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 2b. Phase 13 — Provider fallback chain (resilience):
# When the primary LLM provider fails (network error, timeout, HTTP 408/429/5xx,
# or no key), chat_completion automatically tries the next provider in the chain.
# Auth errors (401/403) and malformed requests still fail fast by design.
# TITAN_PROVIDER_FALLBACK_CHAIN="kimi,glm,ollama,deepseek"
# Optional per-provider model overrides for the chain:
# TITAN_PROVIDER_FALLBACK_MODELS="kimi=kimi-k3,glm=glm-5.3-flash"

# 2c. Phase 14 — Human-in-the-loop approvals:
# Timeout (seconds) the agent waits for a human to decide a pending approval
# request (delete_file / screenshot / ...) before the tool call is abandoned.
# Approvals surfaced via GET /api/hitl/pending and decided via POST /api/hitl/decide.
# Audit trail: workspace/hitl_audit.jsonl
TITAN_HITL_TIMEOUT=120

# 2d. Phase 17 — Bounded parallel tool execution:
# TITAN_PARALLEL_TOOL_CALLS: max tools executing concurrently in one model
# turn (semaphore cap; 1 = fully serial).
TITAN_PARALLEL_TOOL_CALLS=4
# TITAN_CANCEL_ON_TOOL_ERROR=1 stops the batch as soon as any tool fails,
# cancelling the remaining in-flight calls (default 0 = run all, report all).
TITAN_CANCEL_ON_TOOL_ERROR=0
# 2e. Phase 20 — Grounded final validation (anti-hallucination):
# A final answer produced without ANY tool use gets one forced verification
# turn before finalizing (the model may emit tools or decline with NO_TOOLS_NEEDED).
# Set 0 to disable on pure-chat workloads where the extra call matters.
TITAN_FINAL_GROUNDING=1
# 2f. Phase 21 — Dedicated reviewer model + refinement (generate -> strong
# critique -> revise). When a reviewer is configured, the reflection/critic
# pass runs on it instead of the generator, and the generator then revises
# against the critique up to TITAN_REFINEMENT_ROUNDS times (default 1).
# Unset = old behavior (single self-reflection, no extra calls).
#TITAN_REVIEWER_PROVIDER=kimi
#TITAN_REVIEWER_MODEL=
#TITAN_REFINEMENT_ROUNDS=1
# 2g. Phase 22 — Per-tool telemetry + adaptive tool record:
# Tool execution stats (ok/error/latency/output size) are ALWAYS collected and
# exposed via GET /api/tools/stats and the agent's `tool_stats` tool. Setting
# TITAN_TOOL_RECORD=1 additionally injects a "TOOL RECORD" block into future
# system prompts listing tools that keep failing so the model adapts. Off by
# default to keep prompts byte-for-byte stable.
#TITAN_TOOL_RECORD=0
# 2h. Phase 23 — Repeated tool-failure guard (harness-level anti-retry-loop):
# Weak models keep re-sending the SAME failing call with the SAME arguments.
# The harness tolerates TITAN_REPEAT_GUARD_LIMIT identical failures per run,
# then SKIPS further identical attempts and tells the model to change approach.
# On by default (limit 2); set TITAN_REPEAT_GUARD=0 to disable.
#TITAN_REPEAT_GUARD=1
#TITAN_REPEAT_GUARD_LIMIT=2
# 2i. Phase 24 — Task re-anchoring after context compaction:
# Long runs lose the ORIGINAL objective when old messages get compacted (worst
# with small models). When compaction actually drops messages, a compact system
# reminder re-pins the original task right before the next model call, both in
# the proactive per-iteration trim and on provider-window overflow halving.
# Only fires after compaction, so short runs are byte-for-byte unchanged.
#TITAN_TASK_REANCHOR=1
# 2j. Phase 26 — Bounded auto post-check for edit runs:
# When files were actually written/edited, ONE extra verification turn runs
# before finalizing (re-read changed files, run the relevant tests/checks) so
# weak models stop claiming "done" without proof. Bounded to one pass per run;
# read-only runs are byte-for-byte unchanged.
#TITAN_AUTO_POSTCHECK=1
# 2k. Phase 30 — Empty final-answer guard:
# Weak models occasionally end a run with whitespace-only content — the run
# "succeeds" while telling the user nothing. The harness retries ONCE with a
# system prompt asking for the answer; a second empty response becomes an
# explicit notice instead of a silent empty success. Set 0 to disable.
#TITAN_EMPTY_FINAL_GUARD=1
# Phase 25 (evidence-aware critique) has NO env key: the reflection/critic
# prompt always receives a deterministic TOOL EVIDENCE block (tool names,
# results, files written/edited) built from the real round-trips.
# Phase 28 extends that block with a "Repeated failures this run" caution
# sourced from the per-run guard counters, so the critic sees exactly which
# calls keep failing.
# Phase 27 extends the Phase 23 repeated-failure guard to EVERY tool path
# (classic loop, structured engines/ToolBridge, cron, queue, direct calls)
# with one shared per-run counter — same env keys as block 2h above.
# Phase 29 exposes the live guard counters via GET /api/guard/state
# (auth-protected like every /api route).
# Phase 31: the post-check prompt names the exact files the run wrote
# (automatic — no env key). Phase 32: the guard protects structured engines
# (react/plan/tot via ToolBridge) too — same keys as 2h above.
# 2l. Phase 33 — Repeated malformed-arguments guard:
# Tool calls whose arguments cannot be parsed as JSON are skipped (never run
# with empty args) — but weak models re-send THE SAME broken call. The harness
# counts skipped malformed calls per tool NAME and blocks past the limit with
# actionable guidance. Counters reset per run.
#TITAN_MALFORMED_GUARD=1
#TITAN_MALFORMED_GUARD_LIMIT=2
# 2m. Phase 34 — Tool-result size cap:
# Oversized tool outputs (a log dump, a whole-file read) are capped in the
# conversation with an explicit marker that keeps the true total length, so
# one huge output cannot flood the model's context window.
#TITAN_TOOL_RESULT_MAX_CHARS=4000
# Phase 35: GET /api/guard/state also mirrors the malformed-arguments counters
# (malformed.patterns) alongside the repeated-failure blocked_patterns.
# 2n. Phase 36 — Delegated-subagent failure discipline (no env key):
# A FAILED/ERROR subagent result from subagent_delegate/subagent_team is turned
# into an Error-prefixed tool result so the uniform funnel records it: tool
# telemetry, the repeated-failure guard (re-delegating the identical task gets
# blocked) and the critic's TOOL EVIDENCE all see the failure. Success output
# is unchanged.
# 2o. Phase 37 — Dead-end early stop:
# When EVERY tool call in a batch fails (error, skip, or guard block) the run
# may be grinding on a broken path. After TITAN_DEAD_END_WINDOW (default 5)
# consecutive all-failed tool batches the harness stops early with an explicit
# notice instead of burning the remaining steps. 0 disables.
#TITAN_DEAD_END_WINDOW=5
# Phase 38: GET /api/guard/state also reports the guard decision log
# (actions, most recent first), action totals and the dead-end detector
# streak; POST /api/guard/reset clears the live agent's guard state.

# 3. OmniRoute — self-hosted AI gateway (dashboard at http://localhost:20128)
# Auto-routing models: auto, auto/coding, auto/fast, auto/smart, auto/offline, auto/cheap
# The dashboard key is copied to .env (never commit real values).
OMNI_API_KEY=
OMNI_BASE_URL=http://localhost:20128/v1

# 4. Local Ollama settings (if you use a local model):
OLLAMA_BASE_URL=http://localhost:11434

# 5. Agent settings:
TITAN_PORT=7860
TITAN_AUTONOMOUS=true
TITAN_MAX_ITERATIONS=25
TITAN_MODE=fast            # fast | deep | deep_search
TITAN_EFFORT=auto          # auto | low | medium | high | ultra (auto derives from mode)
TITAN_TOKEN_RATE_LIMIT=214000  # token throughput guardrail (tokens/sec, never exceeded)

# 5bb. Phase 15 — Structured JSON logging:
# Level for the JSON logger tree (DEBUG..CRITICAL); every line is emitted as one
# machine-parseable JSON object and mirrored into an in-memory ring (size below)
# that feeds GET /api/logs/recent.
TITAN_LOG_LEVEL=INFO
TITAN_LOG_BUFFER=500

# 5b. Phase 7 — Full Autonomy (unlimited step budget, task queue, daemon):
# TITAN_STEP_CAP: ceiling applied after effort scaling (default 48 — was hardcoded).
TITAN_STEP_CAP=48
# TITAN_UNLIMITED_STEPS=1 removes the step ceiling entirely — the agent keeps
# iterating until the task is provably done (it still must verify + answer).
TITAN_UNLIMITED_STEPS=0
TITAN_DEEP_MAX_STEPS=40

# 5c. Phase 10 — Harness hardening (context resilience + LLM recovery):
# In-run message budget in chars (~4 chars ~= 1 token). When the living context
# of a run exceeds it, the oldest tool rounds are trimmed (whole assistant->tool
# blocks) so long/deep runs never blow the provider window.
TITAN_CONTEXT_BUDGET_CHARS=200000
# Bounded retries for TRANSIENT LLM network errors (ClientError/OSError/timeouts).
# API-level errors (401/403/...) still fail fast. 0 disables retries.
TITAN_LLM_TRANSIENT_RETRIES=2        # deep modes' extra budget base (was hardcoded at 40)
TITAN_TASK_QUEUE=              # SQLite path for the autonomous task queue (default: workspace/task_queue.db)
TITAN_DAEMON_INTERVAL=5.0      # daemon poll interval (seconds)
TITAN_DAEMON_CONCURRENCY=1     # parallel task workers (max concurrent)

# 5c. Phase 8 — FULL ACCESS: remove EVERY capability boundary.
# TITAN_FULL_ACCESS=1 enables:
#   - No step budget cap (budget scaled 4x, no ceiling until task is done)
#   - Command timeout raised from 45s to 10 minutes
#   - Approval gates auto-granted (delete_file / screenshot / ports / paths)
#   - download_file: no 100 MB cap, fetch timeout 30s -> 2 minutes
#   - start_http_server: any valid port (1-65535)
#   - Token rate-limiter disabled
#   - Subagent teams: up to 8 parallel workers
#   Full Access KEEPS the protection floor: destructive-command denies
#   (rm -rf / format / mkfs / shutdown) and the SSRF private-network guard.
# TITAN_ABSOLUTE_ACCESS=1 additionally lifts THOSE two lines too — the last
# protection floor. It implies FULL_ACCESS. Use only when you accept that the
# agent can reach destructive operations and internal networks it asks for.
TITAN_FULL_ACCESS=0
TITAN_ABSOLUTE_ACCESS=0

# 6. Completions.me — free OpenAI-compatible gateway (Claude Opus / GPT-5 / Gemini / Grok)
COMPLETIONS_API_KEY=
COMPLETIONS_BASE_URL=https://completions.me/api/v1

# 7. Telegram account manager (opt-in, consent-gated)
# MUST be true for any Telegram tool to work. Get api_id/api_hash at
# https://my.telegram.org -> API development tools. Never commit real values.
TITAN_TELEGRAM_ENABLED=false
TITAN_TELEGRAM_API_ID=
TITAN_TELEGRAM_API_HASH=
# Comma-separated targets the agent may message (empty = read-only, no sending)
TITAN_TELEGRAM_SEND_ALLOWLIST=

# 8. Obsidian vault (MCP — obsidian-mcp@2, Node 22+, no plugin/API key needed).
# Absolute path to your vault folder; the server works directly on the Markdown
# files, so Obsidian itself doesn't even need to be open.
#   Windows example: OBSIDIAN_VAULT=C:\Users\me\Documents\MyVault
#   (backslashes are fine in a normal .env value; use forward slashes if set via cmd)
OBSIDIAN_VAULT=